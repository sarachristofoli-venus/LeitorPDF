{
  "name": "leitor-pdf",
  "version": "1.5.0",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/build-winocr.cjs && electron .",
    "dist": "node scripts/build-winocr.cjs && electron-builder --win nsis",
    "winocr": "node scripts/build-winocr.cjs --force",
    "icon": "python scripts/make_icon.py"
  },
  "author": "Sara Christofoli",
  "license": "MIT",
  "description": "Leitor de PDF com anotações, OCR (Windows ou Tesseract), editor de matéria e criação de PDF a partir de imagens",
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "productName": "Leitor PDF",
  "build": {
    "appId": "com.christofoli.leitorpdf",
    "productName": "Leitor PDF",
    "copyright": "© 2026 Sara Christofoli",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!**/*.map",
      "!node_modules/pdfjs-dist/build/pdf.mjs",
      "!node_modules/pdfjs-dist/build/pdf.worker.mjs",
      "!node_modules/pdfjs-dist/build/pdf.sandbox*",
      "!node_modules/@napi-rs/**",
      "!node_modules/tesseract.js/src/**",
      "!node_modules/tesseract.js/docs/**",
      "!node_modules/tesseract.js/examples/**",
      "!node_modules/tesseract.js/scripts/**",
      "!node_modules/tesseract.js/dist/tesseract.min.js",
      "!node_modules/tesseract.js-core/*.wasm",
      "!node_modules/tesseract.js-core/tesseract-core.wasm.js",
      "!node_modules/tesseract.js-core/tesseract-core-simd.wasm.js",
      "!node_modules/tesseract.js-core/tesseract-core-relaxedsimd.wasm.js",
      "!node_modules/tesseract.js-core/tesseract-core.js",
      "!node_modules/tesseract.js-core/tesseract-core-simd.js",
      "!node_modules/tesseract.js-core/tesseract-core-relaxedsimd.js",
      "!node_modules/tesseract.js-core/tesseract-core-lstm.js",
      "!node_modules/tesseract.js-core/tesseract-core-simd-lstm.js",
      "!node_modules/tesseract.js-core/tesseract-core-relaxedsimd-lstm.js",
      "!node_modules/@tesseract.js-data/*/4.0.0/**",
      "!node_modules/pdf-lib/cjs/**",
      "!node_modules/pdf-lib/es/**",
      "!node_modules/pdf-lib/src/**",
      "!node_modules/pdf-lib/ts3.4/**",
      "!node_modules/pdf-lib/dist/pdf-lib.js",
      "!node_modules/pdf-lib/dist/pdf-lib.esm.js"
    ],
    "extraResources": [
      {
        "from": "build/winocr.exe",
        "to": "winocr.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "LeitorPDF"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "description": "Documento PDF",
        "role": "Viewer",
        "icon": "build/icon.ico"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Leitor PDF",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "LeitorPDF-Setup-${version}.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
